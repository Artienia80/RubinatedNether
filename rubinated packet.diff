diff --git a/src/main/java/corundum/rubinated_nether/content/items/RubinatedPacketItem.java b/src/main/java/corundum/rubinated_nether/content/items/RubinatedPacketItem.java
new file mode 100644
index 0000000..fcfce12
--- /dev/null
+++ b/src/main/java/corundum/rubinated_nether/content/items/RubinatedPacketItem.java
@@ -0,0 +1,195 @@
+package corundum.rubinated_nether.content.items;
+
+import net.minecraft.ChatFormatting;
+import net.minecraft.core.component.DataComponents;
+import net.minecraft.network.chat.Component;
+import net.minecraft.server.level.ServerPlayer;
+import net.minecraft.sounds.SoundEvents;
+import net.minecraft.stats.Stats;
+import net.minecraft.world.InteractionHand;
+import net.minecraft.world.InteractionResultHolder;
+import net.minecraft.world.entity.SlotAccess;
+import net.minecraft.world.entity.item.ItemEntity;
+import net.minecraft.world.entity.player.Inventory;
+import net.minecraft.world.entity.player.Player;
+import net.minecraft.world.inventory.ClickAction;
+import net.minecraft.world.inventory.Slot;
+import net.minecraft.world.item.BundleItem;
+import net.minecraft.world.item.ItemStack;
+import net.minecraft.world.item.ItemUtils;
+import net.minecraft.world.item.Items;
+import net.minecraft.world.item.TooltipFlag;
+import net.minecraft.world.item.component.BundleContents;
+import net.minecraft.world.level.Level;
+
+import java.util.List;
+
+public class RubinatedPacketItem extends BundleItem {
+	public static final int SLOTS = 16;
+
+	public RubinatedPacketItem(Properties properties) {
+		super(properties);
+	}
+
+	private static BundleContents contents(ItemStack stack) {
+		return stack.getOrDefault(DataComponents.BUNDLE_CONTENTS, BundleContents.EMPTY);
+	}
+
+	private static boolean isEmerald(ItemStack stack) {
+		return stack.is(Items.EMERALD) && stack.getComponentsPatch().isEmpty();
+	}
+
+	private static boolean isStoredEmerald(ItemStack stack) {
+		return stack.is(Items.EMERALD);
+	}
+
+	private static void applyWeightMarker(ItemStack emerald) {
+		emerald.set(DataComponents.MAX_STACK_SIZE, SLOTS);
+	}
+
+	private static void stripWeightMarker(ItemStack emerald) {
+		if (isStoredEmerald(emerald)) {
+			emerald.set(DataComponents.MAX_STACK_SIZE, emerald.getItem().getDefaultMaxStackSize());
+		}
+	}
+
+	public static int absorb(Player player, ItemStack stack) {
+		if (!isEmerald(stack)) {
+			return 0;
+		}
+		int total = 0;
+		Inventory inventory = player.getInventory();
+		for (int i = 0; i < inventory.getContainerSize() && !stack.isEmpty(); i++) {
+			ItemStack packet = inventory.getItem(i);
+			if (!(packet.getItem() instanceof RubinatedPacketItem)) {
+				continue;
+			}
+			BundleContents.Mutable mutable = new BundleContents.Mutable(contents(packet));
+			applyWeightMarker(stack);
+			int moved = mutable.tryInsert(stack);
+			stripWeightMarker(stack);
+			if (moved > 0) {
+				packet.set(DataComponents.BUNDLE_CONTENTS, mutable.toImmutable());
+				total += moved;
+			}
+		}
+		return total;
+	}
+
+	public static ItemStack withdraw(Player player, int amount) {
+		int taken = 0;
+		Inventory inventory = player.getInventory();
+		for (int i = 0; i < inventory.getContainerSize() && taken < amount; i++) {
+			ItemStack packet = inventory.getItem(i);
+			if (!(packet.getItem() instanceof RubinatedPacketItem)) {
+				continue;
+			}
+			BundleContents.Mutable mutable = new BundleContents.Mutable(contents(packet));
+			boolean changed = false;
+			ItemStack removed;
+			while (taken < amount && (removed = mutable.removeOne()) != null) {
+				int take = Math.min(amount - taken, removed.getCount());
+				removed.shrink(take);
+				taken += take;
+				changed = true;
+				if (!removed.isEmpty()) {
+					mutable.tryInsert(removed);
+				}
+			}
+			if (changed) {
+				packet.set(DataComponents.BUNDLE_CONTENTS, mutable.toImmutable());
+			}
+		}
+		return taken > 0 ? new ItemStack(Items.EMERALD, taken) : ItemStack.EMPTY;
+	}
+
+	public static void collectEmeralds(ItemStack packet, List<Slot> slots, Player player) {
+		BundleContents.Mutable mutable = new BundleContents.Mutable(contents(packet));
+		for (Slot slot : slots) {
+			if (!slot.hasItem() || !slot.mayPickup(player)) {
+				continue;
+			}
+			ItemStack stack = slot.getItem();
+			if (!isEmerald(stack)) {
+				continue;
+			}
+			applyWeightMarker(stack);
+			mutable.tryInsert(stack);
+			stripWeightMarker(stack);
+			slot.setChanged();
+		}
+		packet.set(DataComponents.BUNDLE_CONTENTS, mutable.toImmutable());
+	}
+
+	@Override
+	public boolean overrideStackedOnOther(ItemStack stack, Slot slot, ClickAction action, Player player) {
+		ItemStack target = slot.getItem();
+		boolean emerald = isEmerald(target);
+		if (!target.isEmpty() && !emerald) {
+			return false;
+		}
+		if (emerald) {
+			applyWeightMarker(target);
+		}
+		boolean handled = super.overrideStackedOnOther(stack, slot, action, player);
+		stripWeightMarker(slot.getItem());
+		return handled;
+	}
+
+	@Override
+	public boolean overrideOtherStackedOnMe(ItemStack stack, ItemStack other, Slot slot, ClickAction action, Player player, SlotAccess access) {
+		boolean emerald = isEmerald(other);
+		if (!other.isEmpty() && !emerald) {
+			return false;
+		}
+		if (emerald) {
+			applyWeightMarker(other);
+		}
+		boolean handled = super.overrideOtherStackedOnMe(stack, other, slot, action, player, access);
+		stripWeightMarker(other);
+		stripWeightMarker(access.get());
+		return handled;
+	}
+
+	@Override
+	public InteractionResultHolder<ItemStack> use(Level level, Player player, InteractionHand hand) {
+		ItemStack stack = player.getItemInHand(hand);
+		BundleContents contents = contents(stack);
+		if (contents.isEmpty()) {
+			return InteractionResultHolder.fail(stack);
+		}
+		stack.set(DataComponents.BUNDLE_CONTENTS, BundleContents.EMPTY);
+		if (player instanceof ServerPlayer) {
+			contents.itemCopyStream().forEach(emerald -> {
+				stripWeightMarker(emerald);
+				player.drop(emerald, true);
+			});
+		}
+		player.playSound(SoundEvents.BUNDLE_DROP_CONTENTS, 0.8F, 0.8F + level.getRandom().nextFloat() * 0.4F);
+		player.awardStat(Stats.ITEM_USED.get(this));
+		return InteractionResultHolder.sidedSuccess(stack, level.isClientSide());
+	}
+
+	@Override
+	public void onDestroyed(ItemEntity itemEntity) {
+		BundleContents contents = itemEntity.getItem().get(DataComponents.BUNDLE_CONTENTS);
+		if (contents != null) {
+			itemEntity.getItem().set(DataComponents.BUNDLE_CONTENTS, BundleContents.EMPTY);
+			ItemUtils.onContainerDestroyed(itemEntity, contents.itemCopyStream().peek(RubinatedPacketItem::stripWeightMarker).toList());
+		}
+	}
+
+	@Override
+	public boolean isFoil(ItemStack stack) {
+		return true;
+	}
+
+	@Override
+	public void appendHoverText(ItemStack stack, TooltipContext context, List<Component> tooltipComponents, TooltipFlag tooltipFlag) {
+		int count = contents(stack).itemCopyStream().mapToInt(ItemStack::getCount).sum();
+		tooltipComponents.add(
+				Component.translatable("item.rubinated_nether.rubinated_packet.tooltip.contents", count, SLOTS)
+						.withStyle(ChatFormatting.GRAY)
+		);
+	}
+}
